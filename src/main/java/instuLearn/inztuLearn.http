              "name": "US005_TC04_ATID_get_delete",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "",
                      "const jsonData = pm.response.json();",
                      "const sentCourseId = pm.variables.get(\"courseId\");",
                      "",
                      "pm.test(\"Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test(\"Response time is less than 3000ms\", function () {",
                      "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                      "});",
                      "",
                      "pm.test(\"'remark' is 'success'\", function () {",
                      "    pm.expect(jsonData.remark).to.eql(\"success\");",
                      "});",
                      ""
                    ]
                  }
                },
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "",
                      "const baseUrl = pm.environment.get(\"base_url\") || \"https://qa.instulearn.com\";",
                      "const token = pm.environment.get(\"adminToken\");",
                      "",
                      "pm.sendRequest({",
                      "    url: baseUrl + \"/api/courses\",",
                      "    method: \"GET\",",
                      "    header: {",
                      "        \"Accept\": \"application/json\",",
                      "        \"x-api-key\": \"1234\",",
                      "        \"Authorization\": \"Bearer \" + token",
                      "    }",
                      "}, function (err, res) {",
                      "    if (err) {",
                      "        console.log(\"GET /api/courses error:\", err);",
                      "        return;",
                      "    }",
                      "",
                      "    const jsonData = res.json();",
                      "",
                      "    if (!jsonData || !jsonData.AddedCourseID || !Array.isArray(jsonData.AddedCourseID.webinars)) {",
                      "        console.log(\"Unexpected response structure:\", JSON.stringify(jsonData).substring(0, 500));",
                      "        return;",
                      "    }",
                      "",
                      "    const webinars = jsonData.AddedCourseID.webinars;",
                      "    const ids = webinars.map(function (w) { return w.id; }).filter(function(id) { return typeof id === \"number\"; });",
                      "",
                      "    if (ids.length === 0) {",
                      "        console.log(\"No course IDs found.\");",
                      "        return;",
                      "    }",
                      "",
                      "    const maxId = Math.max(...ids);",
                      "    console.log(\"All IDs:\", ids);",
                      "    console.log(\"Max ID selected for deletion:\", maxId);",
                      "",
                      "    pm.variables.set(\"courseId\", maxId);",
                      "    pm.request.url = pm.request.url.toString().replace(\"/api/deleteCourse\", \"/api/deleteCourse/\" + maxId);",
                      "});",
                      ""
                    ]
                  }
                }
              ],
