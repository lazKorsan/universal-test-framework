            {
              "name": "US001_TC01_ATIN_get",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "// ===== BÖLÜM 1: Durum ve Yanıt Süresi (Status & Response Time) =====",
                      "",
                      "pm.test(\"Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test(\"Status code is NOT 4xx\", function () {",
                      "    pm.expect(pm.response.code).to.be.below(400);",
                      "});",
                      "",
                      "pm.test(\"Response time is less than 3000ms\", function () {",
                      "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                      "});",
                      "",
                      "pm.test(\"Content-Type header includes application/json\", function () {",
                      "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                      "});",
                      "",
                      "// ===== BÖLÜM 2: Üst Seviye Yapı (Top-Level Response Structure) =====",
                      "",
                      "pm.test(\"Response body is valid JSON (not array, not null)\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    pm.expect(jsonData).to.be.an(\"object\").and.not.equal(null);",
                      "    pm.expect(Array.isArray(jsonData)).to.be.false;",
                      "});",
                      "",
                      "const jsonData = pm.response.json();",
                      "",
                      "pm.test(\"Root-level has exactly 3 keys: 'remark', 'status', 'AddedCourseID'\", function () {",
                      "    const keys = Object.keys(jsonData);",
                      "    pm.expect(keys).to.have.lengthOf(3);",
                      "    pm.expect(keys).to.include.members([\"remark\", \"status\", \"AddedCourseID\"]);",
                      "});",
                      "",
                      "pm.test(\"'remark' exists and is a string\", function () {",
                      "    pm.expect(jsonData).to.have.property(\"remark\");",
                      "    pm.expect(jsonData.remark).to.be.a(\"string\");",
                      "});",
                      "",
                      "pm.test(\"'remark' is exactly 'success'\", function () {",
                      "    pm.expect(jsonData.remark).to.eql(\"success\");",
                      "});",
                      "",
                      "pm.test(\"'remark' is NOT 'failed'\", function () {",
                      "    pm.expect(jsonData.remark).to.not.eql(\"failed\");",
                      "});",
                      "",
                      "pm.test(\"'status' exists and is a number\", function () {",
                      "    pm.expect(jsonData).to.have.property(\"status\");",
                      "    pm.expect(jsonData.status).to.be.a(\"number\");",
                      "});",
                      "",
                      "pm.test(\"'status' is exactly 200\", function () {",
                      "    pm.expect(jsonData.status).to.eql(200);",
                      "});",
                      "",
                      "pm.test(\"'AddedCourseID' exists and is an object (not array, not null)\", function () {",
                      "    pm.expect(jsonData).to.have.property(\"AddedCourseID\");",
                      "    pm.expect(jsonData.AddedCourseID).to.be.an(\"object\").and.not.equal(null);",
                      "    pm.expect(Array.isArray(jsonData.AddedCourseID)).to.be.false;",
                      "});",
                      "",
                      "// ===== BÖLÜM 3: AddedCourseID Nesnesi (AddedCourseID Object) =====",
                      "",
                      "pm.test(\"'AddedCourseID.pageTitle' exists and is a string\", function () {",
                      "    pm.expect(jsonData.AddedCourseID).to.have.property(\"pageTitle\");",
                      "    pm.expect(jsonData.AddedCourseID.pageTitle).to.be.a(\"string\");",
                      "});",
                      "",
                      "pm.test(\"'AddedCourseID.pageTitle' is exactly 'Webinars'\", function () {",
                      "    pm.expect(jsonData.AddedCourseID.pageTitle).to.eql(\"Webinars\");",
                      "});",
                      "",
                      "pm.test(\"'AddedCourseID.totalWebinars' exists and is a number\", function () {",
                      "    pm.expect(jsonData.AddedCourseID).to.have.property(\"totalWebinars\");",
                      "    pm.expect(jsonData.AddedCourseID.totalWebinars).to.be.a(\"number\");",
                      "});",
                      "",
                      "pm.test(\"'AddedCourseID.totalWebinars' is greater than 0\", function () {",
                      "    pm.expect(jsonData.AddedCourseID.totalWebinars).to.be.above(0);",
                      "});",
                      "",
                      "pm.test(\"'AddedCourseID.webinars' exists and is an array\", function () {",
                      "    pm.expect(jsonData.AddedCourseID).to.have.property(\"webinars\");",
                      "    pm.expect(jsonData.AddedCourseID.webinars).to.be.an(\"array\");",
                      "});",
                      "",
                      "pm.test(\"'AddedCourseID.webinars' array is not empty\", function () {",
                      "    pm.expect(jsonData.AddedCourseID.webinars.length).to.be.above(0);",
                      "});",
                      "",
                      "pm.test(\"'AddedCourseID.webinars.length' is less than or equal to 'AddedCourseID.totalWebinars'\", function () {",
                      "    pm.expect(jsonData.AddedCourseID.webinars.length).to.be.at.most(jsonData.AddedCourseID.totalWebinars);",
                      "});",
                      "",
                      "",
                      "",
                      "",
                      "// ===== BÖLÜM 5: Webinar Alan Değer Doğrulamaları (Webinar Field Value Validations) =====",
                      "",
                      "pm.test(\"Each webinar 'id' is greater than 0\", function () {",
                      "    jsonData.AddedCourseID.webinars.forEach(function (webinar, index) {",
                      "        pm.expect(webinar.id, `webinar[${index}].id`).to.be.above(0);",
                      "    });",
                      "});",
                      "",
                      "pm.test(\"Each webinar 'type' is either 'course' or 'webinar'\", function () {",
                      "    jsonData.AddedCourseID.webinars.forEach(function (webinar, index) {",
                      "        pm.expect([\"course\", \"webinar\"], `webinar[${index}].type`).to.include(webinar.type);",
                      "    });",
                      "});",
                      "",
                      "",
                      "",
                      "pm.test(\"Each webinar 'slug' is not an empty string\", function () {",
                      "    jsonData.AddedCourseID.webinars.forEach(function (webinar, index) {",
                      "        pm.expect(webinar.slug, `webinar[${index}].slug`).to.not.eql(\"\");",
                      "    });",
                      "});",
                      "",
                      "pm.test(\"Each webinar has 'translations' array that is not null\", function () {",
                      "    jsonData.AddedCourseID.webinars.forEach(function (webinar, index) {",
                      "        pm.expect(webinar, `webinar[${index}] translations`).to.have.property(\"translations\");",
                      "        pm.expect(webinar.translations, `webinar[${index}].translations`).to.not.equal(null);",
                      "        pm.expect(webinar.translations, `webinar[${index}].translations`).to.be.an(\"array\");",
                      "    });",
                      "});",
                      "",
                      "// ===== BÖLÜM 6: Çeviri Yapısı (Translations Structure) =====",
                      "",
                      "pm.test(\"Each webinar's 'translations' is an array\", function () {",
                      "    jsonData.AddedCourseID.webinars.forEach(function (webinar, index) {",
                      "        pm.expect(webinar.translations, `webinar[${index}].translations`).to.be.an(\"array\");",
                      "    });",
                      "});",
                      "",
                      "pm.test(\"For webinars with translations, each translation has required fields\", function () {",
                      "    jsonData.AddedCourseID.webinars.forEach(function (webinar, wIndex) {",
                      "        if (webinar.translations.length > 0) {",
                      "            webinar.translations.forEach(function (translation, tIndex) {",
                      "                pm.expect(translation.id, `webinar[${wIndex}].translations[${tIndex}].id`).to.be.a(\"number\");",
                      "                pm.expect(translation.webinar_id, `webinar[${wIndex}].translations[${tIndex}].webinar_id`).to.be.a(\"number\");",
                      "                pm.expect(translation.locale, `webinar[${wIndex}].translations[${tIndex}].locale`).to.be.a(\"string\");",
                      "                pm.expect(translation.title, `webinar[${wIndex}].translations[${tIndex}].title`).to.be.a(\"string\");",
                      "            });",
                      "        }",
                      "    });",
                      "});",
                      "",
                      "// ===== BÖLÜM 7: Sayısal ve Opsiyonel Alan Tipleri (Numeric & Optional Field Types) =====",
                      "",
                      "pm.test(\"Each webinar 'duration' — if not null, is a number\", function () {",
                      "    jsonData.AddedCourseID.webinars.forEach(function (webinar, index) {",
                      "        if (webinar.duration !== null) {",
                      "            pm.expect(webinar.duration, `webinar[${index}].duration`).to.be.a(\"number\");",
                      "        }",
                      "    });",
                      "});",
                      "",
                      "pm.test(\"Each webinar 'price' — if not null, is a number\", function () {",
                      "    jsonData.AddedCourseID.webinars.forEach(function (webinar, index) {",
                      "        if (webinar.price !== null) {",
                      "            pm.expect(webinar.price, `webinar[${index}].price`).to.be.a(\"number\");",
                      "        }",
                      "    });",
                      "});",
                      "",
                      "pm.test(\"Each webinar 'capacity' — if not null, is a number\", function () {",
                      "    jsonData.AddedCourseID.webinars.forEach(function (webinar, index) {",
                      "        if (webinar.capacity !== null) {",
                      "            pm.expect(webinar.capacity, `webinar[${index}].capacity`).to.be.a(\"number\");",
                      "        }",
                      "    });",
                      "});",
                      "",
                      "// ===== BÖLÜM 8: Ortam Değişkeni (Environment Variable) =====",
                      "",
                      "pm.environment.set(\"courseId\", jsonData.AddedCourseID.webinars[0].id);",
                      "",
                      "pm.test(\"'courseId' environment variable is set and not null\", function () {",
                      "    pm.expect(pm.environment.get(\"courseId\")).to.not.equal(null);",
                      "    pm.expect(pm.environment.get(\"courseId\")).to.not.equal(undefined);",
                      "});"
