                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                },
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "// Get base_url and adminToken from environment",
                      "const baseUrl = pm.environment.get(\"base_url\") || \"https://qa.instulearn.com\";",
                      "const adminToken = pm.environment.get(\"adminToken\");",
                      "",
                      "// Send GET /api/courses to fetch all courses",
                      "pm.sendRequest({",
                      "    url: baseUrl + \"/api/courses\",",
                      "    method: \"GET\",",
                      "    header: {",
                      "        \"Accept\": \"application/json\",",
                      "        \"x-api-key\": \"1234\",",
                      "        \"Authorization\": \"Bearer \" + adminToken",
                      "    }",
                      "}, function (err, res) {",
                      "    if (err) {",
                      "        console.log(\"GET /api/courses error:\", err);",
                      "        return;",
                      "    }",
                      "",
                      "    const jsonData = res.json();",
                      "",
                      "    // Extract IDs directly from AddedCourseID.webinars (no \"data\" wrapper)",
                      "    let ids = [];",
                      "",
                      "    if (jsonData && jsonData.AddedCourseID && Array.isArray(jsonData.AddedCourseID.webinars)) {",
                      "        ids = jsonData.AddedCourseID.webinars",
                      "            .map(item => item.id)",
                      "            .filter(id => typeof id === \"number\");",
                      "    }",
                      "",
                      "    if (ids.length === 0) {",
                      "        console.log(\"No course IDs found. Full response:\", JSON.stringify(jsonData).substring(0, 500));",
                      "        return;",
                      "    }",
                      "",
                      "    // Find the smallest ID",
                      "    const minId = Math.min(...ids);",
                      "    console.log(\"All IDs:\", ids);",
                      "    console.log(\"Smallest ID selected:\", minId);",
                      "",
                      "    // Set as local variable so {{courseId}} resolves in the request URL",
                      "    pm.variables.set(\"courseId\", minId);",
                      "});"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{adminToken}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "GET",
                "header": [
                  {
                    "key": "x-api-key",
                    "value": "1234"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/api/course/{{courseId}}",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "course",
                    "{{courseId}}"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "US002_TC03_ATIF_A1_get",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "// ===== PRE-REQUEST: Var olmayan bir courseId dinamik olarak üret =====",
                      "const baseUrl = pm.environment.get(\"base_url\");",
                      "const token = pm.environment.get(\"adminToken\");",
                      "",
                      "pm.sendRequest({",
                      "    url: baseUrl + \"/api/courses\",",
                      "    method: \"GET\",",
                      "    header: {",
                      "        \"Authorization\": \"Bearer \" + token,",
                      "        \"Accept\": \"application/json\",",
                      "        \"x-api-key\": \"1234\"",
                      "    }",
                      "}, function(err, res) {",
                      "    if (err) {",
                      "        console.error(\"Pre-request hata: /api/courses isteği başarısız →\", err);",
                      "        return;",
                      "    }",
                      "    if (res.code !== 200) {",
                      "        console.warn(\"Pre-request uyarı: /api/courses beklenen 200 yerine \" + res.code + \" döndürdü.\");",
                      "        return;",
                      "    }",
                      "",
                      "    const data = res.json();",
                      "    const webinars = (data.AddedCourseID && Array.isArray(data.AddedCourseID.webinars))",
                      "        ? data.AddedCourseID.webinars",
                      "        : [];",
                      "",
                      "    if (webinars.length === 0) {",
                      "        console.warn(\"Pre-request uyarı: webinars dizisi boş, courseId set edilemedi.\");",
                      "        return;",
                      "    }",
                      "",
                      "    // Tüm ID'leri tara ve en büyüğünü bul",
                      "    const maxId = webinars.reduce(function(max, webinar) {",
                      "        return (typeof webinar.id === \"number\" && webinar.id > max) ? webinar.id : max;",
                      "    }, webinars[0].id);",
                      "",
                      "    // Var olmayan bir ID: max + 10",
                      "    const nonExistentId = maxId + 10;",
                      "    pm.variables.set(\"courseId\", nonExistentId);",
                      "    console.log(\"Var olmayan courseId set edildi (max + 10): \" + nonExistentId);",
                      "});"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const jsonData = pm.response.json();",
                      "",
                      "// ===== BÖLÜM 1: HTTP & Performans =====",
                      "pm.test(\"HTTP status 203 ve response süresi 3000ms altında\", function () {",
                      "    pm.response.to.have.status(203);",
                      "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                      "});",
                      "",
                      "pm.test(\"Content-Type application/json ve body geçerli JSON\", function () {",
                      "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                      "    pm.response.to.be.json;",
