            {
              "name": "US003_TC04_ATID_post_get",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "// POST response'dan 'Added Course ID' key'i ile courseId'yi al",
                      "const postResponse = pm.response.json();",
                      "const courseId = postResponse[\"Added Course ID\"];",
                      "",
                      "// courseId'yi environment variable'a kaydet",
                      "pm.environment.set(\"courseId\", courseId);",
                      "",
                      "// GET isteği için değişkenleri hazırla",
                      "const baseUrl = pm.environment.get(\"base_url\");",
                      "const adminToken = pm.environment.get(\"adminToken\");",
                      "",
                      "// GET isteği gönder: {{base_url}}/api/course/{courseId}",
                      "pm.sendRequest({",
                      "    url: `${baseUrl}/api/course/${courseId}`,",
                      "    method: \"GET\",",
                      "    header: {",
                      "        \"Authorization\": `Bearer ${adminToken}`,",
                      "        \"x-api-key\": \"1234\",",
                      "        \"Accept\": \"application/json\"",
                      "    }",
                      "}, function (err, res) {",
                      "    pm.test(\"GET - Status code is 200\", function () {",
                      "        pm.expect(res).to.have.status(200);",
                      "    });",
                      "",
                      "    const getBody = res.json();",
                      "",
                      "    pm.test(\"GET - remark is 'success'\", function () {",
                      "        pm.expect(getBody.remark).to.eql(\"success\");",
                      "    });",
                      "",
                      "    pm.test(\"GET - data.id matches POST response id\", function () {",
                      "        pm.expect(getBody.data.id).to.eql(courseId);",
                      "    });",
                      "",
                      "    pm.test(\"GET - data.translations[0].title is a non-empty string\", function () {",
                      "        pm.expect(getBody.data.translations[0].title).to.be.a(\"string\").and.not.empty;",
                      "    });",
                      "",
                      "    pm.test(\"GET - data.type is 'course'\", function () {",
                      "        pm.expect(getBody.data.type).to.eql(\"course\");",
                      "    });",
                      "});"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                },
