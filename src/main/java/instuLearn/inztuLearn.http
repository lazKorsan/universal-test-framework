                    "exec": [
                      "// ===== US002_TC04_AFIT_get: Geçersiz Token Senaryosu =====",
                      "// Authorization header'ı kasıtlı olarak eksik/geçersiz bırakılıyor",
                      "// Böylece API 401 Unauthenticated döndürür",
                      "",
                      "// Eğer önceki testlerden kalan geçerli bir token varsa, bu istek için kaldır",
                      "pm.request.headers.remove(\"Authorization\");",
                      "",
                      "// Geçersiz (boş) bir token set et — API bunu reddedecek",
                      "pm.request.headers.upsert({",
                      "    key: \"Authorization\",",
                      "    value: \"\"",
                      "});"
                    ]
                  }
                }
