ca,=\\\"\\\" arial,=\\\"\\\" sans-serif,=\\\"\\\" \\\"apple=\\\"\\\" color=\\\"\\\" emoji\\\",=\\\"\\\" ui=\\\"\\\" symbol\\\";=\\\"\\\" font-size:=\\\"\\\" 14px;\\\"=\\\"\\\"></p>\"\n                    }\n                ]\n            },\n            {\n                \"id\": 1998,\n                \"teacher_id\": 1015,\n                \"creator_id\": 1015,\n                \"category_id\": 605,\n                \"type\": \"webinar\",\n                \"private\": 0,\n                \"slug\": \"Beauty-Makeup\",\n                \"start_date\": 1727814600,\n                \"duration\": 100,\n                \"timezone\": \"America/New_York\",\n                \"thumbnail\": \"/store/1/makeup.jpg\",\n                \"image_cover\": \"/store/1/high-angle-view-woman-hand-table.jpg\",\n                \"video_demo\": \"https://www.youtube.com/watch?v=O_qgaOUR3Fo\",\n                \"video_demo_source\": \"youtube\",\n                \"capacity\": 50,\n                \"price\": 100,\n                \"organization_price\": null,\n                \"support\": 1,\n                \"certificate\": 1,\n                \"downloadable\": 0,\n                \"partner_instructor\": 1,\n                \"subscribe\": 1,\n                \"forum\": 0,\n                \"enable_waitlist\": 0,\n                \"access_days\": 730,\n                \"points\": null,\n                \"message_for_reviewer\": \"thank you.\",\n                \"status\": \"active\",\n                \"created_at\": 1624965321,\n                \"updated_at\": 1713342716,\n                \"deleted_at\": null,\n                \"title\": null,\n                \"description\": null,\n                \"seo_description\": null,\n                \"translations\": [\n                    {\n                        \"id\": 4,\n                        \"webinar_id\": 1998,\n                        \"locale\": \"en\",\n                        \"title\": \"Beauty and Makeup Mastery\",\n               