                    "exec": [
                      "// ===== US003_ATIN_post: Geçerli Token ile Kurs Ekleme =====",
                      "// Dinamik test verisi oluştur — her çalıştırmada benzersiz slug ve title",
                      "const timestamp = Date.now();",
                      "const randomSuffix = Math.floor(Math.random() * 10000);",
                      "",
                      "pm.variables.set(\"dynamic_title\", \"Health And Fitness \" + randomSuffix);",
                      "pm.variables.set(\"dynamic_slug\", \"health-and-fitness-\" + timestamp);"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const jsonData = pm.response.json();",
                      "",
                      "// ===== BÖLÜM 1: HTTP & Performans =====",
                      "pm.test(\"HTTP status kodu 200 olmalı\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test(\"Response süresi 3000ms altında olmalı\", function () {",
                      "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                      "});",
                      "",
                      "pm.test(\"Content-Type başlığı 'application/json' içermeli\", function () {",
                      "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                      "});",
                      "",
                      "pm.test(\"Response body geçerli JSON formatında olmalı\", function () {",
                      "    pm.response.to.be.json;",
                      "});",
                      "",
                      "// ===== BÖLÜM 2: Üst Seviye Yapı =====",
                      "pm.test(\"Response body 'remark', 'status', 'Message' ve 'Added Course ID' alanlarını içermeli\", function () {",
                      "    pm.expect(jsonData).to.have.property(\"remark\");",
                      "    pm.expect(jsonData).to.have.property(\"status\");",
                      "    pm.expect(jsonData).to.have.property(\"Message\");",
                      "    pm.expect(jsonData).to.have.property(\"Added Course ID\");",
                      "});",
                      "",
                      "// ===== BÖLÜM 3: Alan Tipleri =====",
                      "pm.test(\"'remark' string, 'status' number, 'Message' string, 'Added Course ID' number tipinde olmalı\", function () {",
                      "    pm.expect(jsonData.remark).to.be.a(\"string\");",
                      "    pm.expect(jsonData.status).to.be.a(\"number\");",
                      "    pm.expect(jsonData.Message).to.be.a(\"string\");",
                      "    pm.expect(jsonData[\"Added Course ID\"]).to.be.a(\"number\");",
                      "});",
                      "",
                      "// ===== BÖLÜM 4: Değer Doğrulama =====",
                      "pm.test(\"'remark' değeri 'success' olmalı\", function () {",
                      "    pm.expect(jsonData.remark).to.eql(\"success\");",
                      "});",
                      "",
                      "pm.test(\"'status' değeri 200 olmalı\", function () {",
                      "    pm.expect(jsonData.status).to.eql(200);",
                      "});",
                      "",
                      "pm.test(\"'Message' değeri 'Successfully Added.' olmalı\", function () {",
                      "    pm.expect(jsonData.Message).to.eql(\"Successfully Added.\");",
                      "});",
                      "",
                      "pm.test(\"'Added Course ID' pozitif bir sayı olmalı\", function () {",
                      "    pm.expect(jsonData[\"Added Course ID\"]).to.be.a(\"number\");",
                      "    pm.expect(jsonData[\"Added Course ID\"]).to.be.above(0);",
                      "});",
                      "",
                      "// ===== BÖLÜM 5: Negatif Senaryo =====",
                      "pm.test(\"Response body 'error' alanı içermemeli\", function () {",
                      "    pm.expect(jsonData).to.not.have.property(\"error\");",
                      "});",
                      "",
                      "pm.test(\"Response body 'errors' alanı içermemeli\", function () {",
                      "    pm.expect(jsonData).to.not.have.property(\"errors\");",
                      "});",
                      "",
                      "// ===== BÖLÜM 6: Ortam Değişkeni Kaydetme =====",
                      "pm.test(\"'Added Course ID' environment variable olarak kaydedilmeli\", function () {",
                      "    const addedId = jsonData[\"Added Course ID\"];",
                      "    pm.expect(addedId).to.be.a(\"number\").and.to.be.above(0);",
                      "    pm.environment.set(\"courseId\", addedId);",
                      "});"
