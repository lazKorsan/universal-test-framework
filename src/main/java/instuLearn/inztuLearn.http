                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "",
                      "// Önce tüm course'ları GET ile çek, max ID'yi bul, +10 ekle",
                      "const baseUrl = pm.environment.get(\"base_url\");",
                      "",
                      "pm.sendRequest({",
                      "    url: baseUrl + \"/api/getCourses\",",
                      "    method: \"GET\",",
                      "    header: {",
                      "        \"x-api-key\": \"1234\",",
                      "        \"Accept\": \"application/json\"",
                      "    }",
                      "}, function (err, res) {",
                      "    if (err) {",
                      "        console.log(\"GET request failed: \" + err);",
                      "        return;",
                      "    }",
                      "",
                      "    const jsonData = res.json();",
                      "",
                      "    // ID'leri topla",
                      "    let ids = [];",
                      "",
                      "    if (Array.isArray(jsonData)) {",
                      "        ids = jsonData.map(item => item.id);",
                      "    } else if (jsonData.data && Array.isArray(jsonData.data)) {",
                      "        ids = jsonData.data.map(item => item.id);",
                      "    } else if (jsonData.courses && Array.isArray(jsonData.courses)) {",
                      "        ids = jsonData.courses.map(item => item.id);",
                      "    }",
                      "",
                      "    const maxId = ids.length > 0 ? Math.max(...ids) : 1000;",
                      "    const nonExistentId = maxId + 10;",
                      "",
                      "    pm.variables.set(\"nonExistentCourseId\", nonExistentId);",
                      "    console.log(\"Non-existent Course ID set to: \" + nonExistentId);",
                      "});",
                      ""
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
