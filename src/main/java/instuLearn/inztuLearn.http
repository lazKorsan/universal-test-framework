                      "});",
                      "",
                      "pm.test(\"TC01 - Each translation has required fields: id, webinar_id, locale, title\", function () {",
                      "    jsonData.data.translations.forEach(function (translation, index) {",
                      "        pm.expect(translation, `Translation at index ${index}`).to.have.property(\"id\");",
                      "        pm.expect(translation, `Translation at index ${index}`).to.have.property(\"webinar_id\");",
                      "        pm.expect(translation, `Translation at index ${index}`).to.have.property(\"locale\");",
                      "        pm.expect(translation, `Translation at index ${index}`).to.have.property(\"title\");",
                      "    });",
                      "});",
                      "",
                      "pm.test(\"TC01 - Each translation 'webinar_id' matches 'data.id'\", function () {",
                      "    const courseId = jsonData.data.id;",
                      "    jsonData.data.translations.forEach(function (translation, index) {",
