              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "// ===== US002_TC01_ATIT_get =====",
                      "// /api/course/{id} endpoint'ine geçerli authorization ve doğru id ile GET request gönderildiğinde",
                      "// status code 200 ve remark \"success\" doğrulanmalı.",
                      "",
                      "// ===== BÖLÜM 1: Durum ve Yanıt Süresi =====",
                      "",
                      "pm.test(\"TC01 - Status code is 200\", function () {",
