              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "// (id) icermeyen bir DELETE request gönderildiginde de dönen status code'in 203,",
                      "// response body'deki remark bilgisinin \"failed\" ve message bilgisinin de \"No id\" oldugu dogrulanmali.",
                      "",
                      "const jsonData = pm.response.json();",
                      "",
                      "pm.test(\"Status code 203 olmalı\", function () {",
                      "    pm.response.to.have.status(203);",
                      "});",
                      "",
                      "pm.test(\"remark 'failed' olmalı\", function () {",
                      "    pm.expect(jsonData.remark).to.eql(\"failed\");",
                      "});",
                      "",
                      "pm.test(\"status alanı 203 olmalı\", function () {",
                      "    pm.expect(jsonData.status).to.eql(203);",
                      "});",
                      "",
                      "pm.test(\"data.message 'No id' olmalı\", function () {",
                      "    pm.expect(jsonData.data.message).to.eql(\"No id\");",
                      "});",
                      "",
                      "pm.test(\"Response body 'data' objesi mevcut olmalı\", function () {",
                      "    pm.expect(jsonData).to.have.property(\"data\");",
                      "});",
                      "",
                      "pm.test(\"Content-Type application/json olmalı\", function () {",
                      "    pm.response.to.have.header(\"Content-Type\");",
                      "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                      "});"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{adminToken}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "DELETE",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
