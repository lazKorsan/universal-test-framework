                    "exec": [
                      "// ===== BÖLÜM 1: Durum Kodu Doğrulama (Status Code Validation) =====",
                      "",
                      "pm.test(\"Status code is 401 Unauthorized\", function () {",
                      "    pm.response.to.have.status(401);",
                      "});",
                      "",
                      "pm.test(\"Status code is NOT 200 (negative check)\", function () {",
                      "    pm.expect(pm.response.code).to.not.equal(200);",
                      "});",
                      "",
                      "pm.test(\"Response time is under 3000ms\", function () {",
                      "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                      "});",
                      "",
                      "// ===== BÖLÜM 2: Response Header Doğrulama (Response Header Validation) =====",
                      "",
                      "pm.test(\"Content-Type header is present\", function () {",
                      "    pm.response.to.have.header(\"Content-Type\");",
                      "});",
                      "",
                      "pm.test(\"Content-Type header contains application/json\", function () {",
                      "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                      "});",
                      "",
                      "// ===== BÖLÜM 3: Response Body Yapısı (Response Body Structure) =====",
                      "",
                      "pm.test(\"Response body is valid JSON\", function () {",
                      "    pm.response.to.be.json;",
                      "});",
                      "",
                      "pm.test(\"Response body is not empty\", function () {",
                      "    const responseBody = pm.response.text();",
                      "    pm.expect(responseBody).to.not.be.empty;",
                      "});",
                      "",
                      "pm.test(\"Response body contains 'message' field\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    pm.expect(jsonData).to.have.property(\"message\");",
                      "});",
                      "",
                      "pm.test(\"'message' field is of type string\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    pm.expect(jsonData.message).to.be.a(\"string\");",
                      "});",
                      "",
                      "// ===== BÖLÜM 4: Hata Mesajı Doğrulama (Error Message Validation) =====",
                      "",
                      "pm.test(\"'message' value is exactly 'Unauthenticated.'\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    pm.expect(jsonData.message).to.equal(\"Unauthenticated.\");",
                      "});",
                      "",
                      "pm.test(\"'message' value is not an empty string\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    pm.expect(jsonData.message).to.not.equal(\"\");",
                      "});",
                      "",
                      "",
                      "",
                      "// ===== BÖLÜM 5: Yetkilendirme Reddi Kontrolü (Authorization Rejection Control) =====",
                      "",
                      "pm.test(\"Response does not contain 'data' field (no data for unauthorized user)\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    pm.expect(jsonData).to.not.have.property(\"data\");",
                      "});",
                      "",
                      "pm.test(\"Response does not contain 'courses' or 'webinars' fields\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    pm.expect(jsonData).to.not.have.property(\"courses\");",
                      "    pm.expect(jsonData).to.not.have.property(\"webinars\");",
                      "});",
                      "",
                      "pm.test(\"Response does not contain 'remark' field (success response field)\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    pm.expect(jsonData).to.not.have.property(\"remark\");",
                      "});",
                      "",
                      "// ===== BÖLÜM 6: Güvenlik ve Negatif Senaryo Özeti (Security & Negative Scenario Summary) =====",
                      "",
                      "pm.test(\"API correctly returns 401 for invalid token\", function () {",
                      "    pm.expect(pm.response.code).to.equal(401);",
                      "});",
                      "",
                      "pm.test(\"Response body contains minimal information (key count <= 1)\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    const keyCount = Object.keys(jsonData).length;",
                      "    pm.expect(keyCount).to.be.at.most(1);",
                      "});",
                      "",
                      "pm.test(\"TC03 - Invalid token returns 401 Unauthenticated\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    pm.expect(pm.response.code).to.equal(401);",
                      "    pm.expect(jsonData.message).to.equal(\"Unauthenticated.\");",
                      "});"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
