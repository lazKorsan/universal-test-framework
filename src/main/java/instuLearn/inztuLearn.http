                      "        return;",
                      "    }",
                      "",
                      "    pm.variables.set(\"adminTokenLocal\", token);",
                      "",
                      "    // Step 2: Create a new course with the valid token",
                      "    const slug = \"tc03-test-course-\" + Date.now();",
                      "",
                      "    pm.sendRequest({",
                      "        url: baseUrl + \"/api/addCourse\",",
                      "        method: \"POST\",",
                      "        header: {",
                      "            \"Content-Type\": \"application/json\",",
                      "            \"Accept\": \"application/json\",",
                      "            \"x-api-key\": \"1234\",",
                      "            \"Authorization\": \"Bearer \" + token",
