                      "});",
                      "",
                      "pm.test(\"TC01 - Response time is less than 3000ms\", function () {",
                      "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                      "});",
                      "",
                      "pm.test(\"TC01 - Content-Type header contains application/json\", function () {",
                      "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                      "});",
                      "",
                      "// ===== BÖLÜM 2: Üst Seviye Yanıt Yapısı =====",
                      "",
                      "pm.test(\"TC01 - Response body is valid JSON\", function () {",
                      "    pm.response.to.be.json;",
                      "});",
                      "",
                      "const jsonData = pm.response.json();",
                      "",
                      "pm.test(\"TC01 - 'remark' field exists and is a string\", function () {",
                      "    pm.expect(jsonData).to.have.property(\"remark\");",
