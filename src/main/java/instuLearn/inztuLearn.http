    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "requests": {},
        "exec": [
          "// Set base_url if not already set",
          "if (!pm.environment.get(\"base_url\")) {",
          "    pm.environment.set(\"base_url\", \"https://qa.instulearn.com\");",
          "}",
          "",
          "// Auto-fetch token if not already set",
          "if (!pm.environment.get(\"adminToken\")) {",
          "    const baseUrl = pm.environment.get(\"base_url\") || \"https://qa.instulearn.com\";",
          "",
          "    pm.sendRequest({",
          "        url: baseUrl + \"/api/token\",",
          "        method: \"POST\",",
          "        header: {",
          "            \"Content-Type\": \"application/json\",",
          "            \"Accept\": \"application/json\",",
          "            \"x-api-key\": \"1234\"",
          "        },",
          "        body: {",
          "            mode: \"raw\",",
          "            raw: JSON.stringify({",
          "                email: \"ahmet.admin@instulearn.com\",",
          "                password: \"Instu123123\"",
          "            })",
          "        }",
          "    }, function (err, res) {",
          "        if (err) {",
          "            console.error(\"Token request failed with error:\", err);",
          "            return;",
          "        }",
          "",
          "        if (res.code !== 200) {",
          "            console.error(\"Token request returned non-200 status:\", res.code, res.text());",
          "            return;",
          "        }",
          "",
          "        const tokenResponse = res.json();",
          "",
          "        if (!tokenResponse || !tokenResponse.data || !tokenResponse.data.access_token) {",
          "            console.error(\"access_token not found in response:\", JSON.stringify(tokenResponse).substring(0, 500));",
          "            return;",
          "        }",
          "",
          "        pm.environment.set(\"adminToken\", tokenResponse.data.access_token);",
          "        console.log(\"adminToken set successfully.\");",
          "    });",
          "}"
        ]
      }
    },
