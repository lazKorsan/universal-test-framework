                      "pm.test(\"11. Response body is an object (not an array)\", function () {",
                      "    var jsonData = pm.response.json();",
                      "    pm.expect(jsonData).to.be.an(\"object\").and.not.an(\"array\");",
                      "});",
                      "",
                      "// ─── 12. Response Body - only expected keys ───────────────────────────────────",
                      "pm.test(\"12. Response body contains only the expected 'message' key (no unexpected extra fields)\", function () {",
                      "    var jsonData = pm.response.json();",
                      "    var allowedKeys = [\"message\"];",
                      "    var actualKeys = Object.keys(jsonData);",
