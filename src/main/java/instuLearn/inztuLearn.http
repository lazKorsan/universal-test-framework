            {
              "name": "US005_TC02_A1_ATIF_get_delete",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "// GET /api/courses isteği ile mevcut kursları listele",
                      "const baseUrl = pm.environment.get(\"base_url\");",
                      "const token = pm.environment.get(\"adminToken\");",
                      "",
                      "pm.sendRequest({",
                      "    url: baseUrl + \"/api/courses\",",
                      "    method: \"GET\",",
                      "    header: {",
                      "        \"Accept\": \"application/json\",",
                      "        \"x-api-key\": \"1234\",",
                      "        \"Authorization\": \"Bearer \" + token",
                      "    }",
                      "}, function (err, res) {",
                      "    if (err) {",
                      "        console.error(\"GET /api/courses isteği başarısız:\", err);",
                      "        return;",
                      "    }",
                      "",
                      "    const jsonData = res.json();",
                      "",
                      "    // Kurs listesini al",
                      "    const webinars = jsonData.AddedCourseID && jsonData.AddedCourseID.webinars",
                      "        ? jsonData.AddedCourseID.webinars",
                      "        : [];",
                      "",
                      "    if (webinars.length === 0) {",
                      "        console.warn(\"Kurs listesi boş, invalidCourseId olarak 9999 atanıyor.\");",
                      "        pm.environment.set(\"invalidCourseId\", 9999);",
                      "        return;",
                      "    }",
                      "",
                      "    // En büyük ID'yi bul",
                      "    const maxId = Math.max(...webinars.map(w => w.id));",
                      "",
                      "    // Max ID + 10 → kesinlikle var olmayan bir ID",
                      "    const invalidId = maxId + 10;",
                      "",
                      "    pm.environment.set(\"invalidCourseId\", invalidId);",
                      "    console.log(\"Max kurs ID:\", maxId, \"→ invalidCourseId:\", invalidId);",
                      "});"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "// Görev: /api/deleteCourse/{id} endpoint'ine geçerli authorization bilgileri ve",
                      "// kaydı olmayan bir (id) içeren bir DELETE request gönderildiğinde:",
                      "// - Status code 203 olmalı",
                      "// - response body'deki remark \"failed\" olmalı",
                      "// - message \"There is not course for this id.\" olmalı",
                      "",
                      "const jsonData = pm.response.json();",
                      "",
                      "pm.test(\"Status code 203 olmalı\", function () {",
                      "    pm.response.to.have.status(203);",
                      "});",
                      "",
                      "pm.test(\"remark 'failed' olmalı\", function () {",
                      "    pm.expect(jsonData.remark).to.eql(\"failed\");",
                      "});",
                      "",
                      "pm.test(\"Message 'There is not course for this id.' olmalı\", function () {",
                      "    pm.expect(jsonData.data.message).to.eql(\"There is not course for this id.\");",
                      "});",
                      "",
                      "// Temizlik: invalidCourseId değişkenini sil",
                      "pm.environment.unset(\"invalidCourseId\");"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{adminToken}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "DELETE",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "x-api-key",
                    "value": "1234"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": ""
                },
                "url": {
                  "raw": "{{base_url}}/api/deleteCourse/{{invalidCourseId}}",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
