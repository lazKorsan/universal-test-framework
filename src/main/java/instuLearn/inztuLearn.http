                      "// ─── 4. Content-Type Header contains application/json ─────────────────────────",
                      "pm.test(\"4. Content-Type header contains 'application/json'\", function () {",
                      "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                      "});",
                      "",
                      "// ─── 5. Response Body - Not Empty ─────────────────────────────────────────────",
                      "pm.test(\"5. Response body is not empty\", function () {",
                      "    pm.expect(pm.response.text()).to.not.be.empty;",
                      "});",
                      "",
                      "// ─── 6. Response Body - Valid JSON ────────────────────────────────────────────",
                      "pm.test(\"6. Response body is valid JSON\", function () {",
                      "    pm.response.to.be.json;",
                      "    var jsonData = pm.response.json();",
                      "    pm.expect(jsonData).to.not.be.null;",
                      "});",
                      "",
                      "// ─── 7. Response Body - message field exists ──────────────────────────────────",
                      "pm.test(\"7. Response body has a 'message' field\", function () {",
                      "    var jsonData = pm.response.json();",
                      "    pm.expect(jsonData).to.have.property(\"message\");",
                      "});",
                      "",
                      "// ─── 8. Response Body - message type is string ────────────────────────────────",
                      "pm.test(\"8. 'message' field is a string\", function () {",
                      "    var jsonData = pm.response.json();",
                      "    pm.expect(jsonData.message).to.be.a(\"string\");",
                      "});",
