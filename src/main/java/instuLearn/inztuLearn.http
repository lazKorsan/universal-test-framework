 null,\n                \"video_demo_source\": null,\n                \"capacity\": null,\n                \"price\": null,\n                \"organization_price\": null,\n                \"support\": 0,\n                \"certificate\": 0,\n                \"downloadable\": 0,\n                \"partner_instructor\": 0,\n                \"subscribe\": 0,\n                \"forum\": 0,\n                \"enable_waitlist\": 0,\n                \"access_days\": null,\n                \"points\": null,\n                \"message_for_reviewer\": null,\n                \"status\": \"is_draft\",\n                \"created_at\": 1714604633,\n                \"updated_at\": 1714842165,\n                \"deleted_at\": null,\n                \"title\": null,\n                \"description\": null,\n                \"seo_description\": null,\n                \"translations\": [\n                    {\n                        \"id\": 184,\n                        \"webinar_id\": 2036,\n                        \"locale\": \"en\",\n                        \"title\": \"ADWAD\",\n                        \"seo_description\": null,\n                        \"description\": \"<p>DWADWA</p>\"\n                    }\n                ]\n            },\n            {\n                \"id\": 2037,\n                \"teacher_id\": 1108,\n                \"creator_id\": 1108,\n                \"category_id\": 618,\n                \"type\": \"course\",\n                \"private\": 0,\n                \"slug\": \"How-To-Become-A-Tester\",\n                \"start_date\": 1714597200,\n                \"duration\": 45,\n                \"timezone\": \"Europe/Istanbul\",\n                \"thumbnail\": \"/store/1108/7-Common-Types-of-Software-Testing@1x.png\",\n                \"image_cover\": \"/store/1108/images.jpeg\",\n                \"video_demo\": null,\n                \"video_demo_source\": null,\n                \"capacity\": 10,\n                \"price\": 10,\n                \"organization_price\": null,\n                \"support\": 0,\n                \"certificate\": 0,\n                \"downloadable\": 0,\n                \"partner_instructor\": 0,\n                \"subscribe\": 0,\n                \"forum\": 0,\n                \"enable_waitlist\": 0,\n                \"access_days\": null,\n                \"points\": null,\n                \"message_for_reviewer\": null,\n                \"status\": \"active\",\n                \"created_at\": 1714658837,\n                \"updated_at\": 1714999378,\n                \"deleted_at\": null,\n                \"title\": null,\n                \"description\": null,\n                \"seo_description\": null,\n                \"translations\": [\n                    {\n                        \"id\": 185,\n                        \"webinar_id\": 2037,\n                        \"locale\": \"en\",\n                        \"title\": \"How To Become A Tester\",\n                        \"seo_description\": \"A comprehensive course for those who want to master the field of test engineering. It offers a wide range of training, from test automation to manual testing techniques. By providing practice with real-world scenarios, it prepares students for a successful career in industry.\",\n                        \"description\": \"<p><span style=\\\"color: rgb(13, 13, 13); font-family: Söhne, ui-sans-serif, system-ui, -apple-system, \\\" segoe=\\\"\\\" ui\\\",=\\\"\\\" roboto,=\\\"\\\" ubuntu,=\\\"\\\" cantarell,=\\\"\\\" \\\"noto=\\\"\\\" sans\\\",=\\\"\\\" sans-serif,=\\\"\\\" \\\"helvetica=\\\"\\\" neue\\\",=\\\"\\\" arial,=\\\"\\\" \\\"apple=\\\"\\\" color=\\\"\\\" emoji\\\",=\\\"\\\" \\\"segoe=\\\"\\\" ui=\\\"\\\" symbol\\\",=\\\"\\\" emoji\\\";=\\\"\\\" white-space-collapse:=\\\"\\\" preserve;\\\"=\\\"\\\">Our Tester course provides an excellent opportunity for anyone who wants to gain an in-depth understanding of software testing. This course offers a comprehensive curriculum covering testing strategies, automation tools, error reporting methods, and testing processes. Supported by hands-on experiences in real-world projects, this course allows participants to gain a foothold in the industry with confidence. Under the guidance of our certified instructors, participants learn to create test scenarios, find and report bugs, while discovering best practices in testing processes. The Tester course is suitable for both beginners and experienced professionals and offers participants the opportunity to reach a level of expertise in the field of test engineering.</span><br></p>\"\n                    }\n                ]\n            },\n            {\n                \"id\": 2039,\n                \"teacher_id\": 1083,\n                \"creator_id\": 1083,\n                \"category_id\": 622,\n                \"type\": \"webinar\",\n                \"private\": 0,\n                \"slug\": \"Volleyball-Referee\",\n                \"start_date\": 1715745600,\n                \"duration\": 678,\n                \"timezone\": \"America/New_York\",\n                \"thumbnail\": \"/store/1083/9070.jpg\",\n                \"image_cover\": \"/store/1083/9070.jpg\",\n                \"video_demo\": null,\n                \"video_demo_source\": null,\n                \"capacity\": 29,\n                \"price\": 1100,\n                \"organization_price\": null,\n                \"support\": 1,\n                \"certificate\": 1,\n                \"downloadable\": 1,\n                \"partner_instructor\": 0,\n                \"subscribe\": 0,\n                \"forum\": 0,\n                \"enable_waitlist\": 0,\n                \"access_days\": 5,\n                \"points\": null,\n                \"message_for_reviewer\": null,\n                \"status\": \"active\",\n                \"created_at\": 1714692452,\n                \"updated_at\": 1716075904,\n                \"deleted_at\": null,\n                \"title\": null,\n                \"description\": null,\n                \"seo_description\": null,\n                \"translations\": [\n                    {\n                        \"id\": 187,\n                        \"webinar_id\": 2039,\n                        \"locale\": \"en\",\n                        \"title\": \"Volleyball Referee\",\n                        \"seo_description\": \"Becoming a volleyball referee involves several steps, but it's an achievable goal for anyone passionate about the sport and willing to put in the effort. Firstly, familiarize yourself with the rules and regulations of volleyball thoroughly. Understanding the intricacies of the game is crucial for making accurate calls during matches. Consider enrolling in a referee training program or workshop offered by local sports organizations or volleyball associations. These programs often provide comprehensive training on officiating techniques, positioning, and decision-making skills. Additionally, gaining practical experience by officiating matches at lower levels, such as local club or school games, can be invaluable for honing your skills and confidence on the court. Networking with experienced referees and seeking mentorship opportunities can also provide valuable guidance and support as you progress in your officiating journey. Finally, continue to refine your knowledge and skills through ongoing education and participation in workshops, seminars, and certification programs to stay updated on rule changes and best practices in volleyball officiating. With dedication and perseverance, you can become a competent and respected volleyball referee.\",\n                        \"description\": \"<font color=\\\"#000000\\\" style=\\\"\\\"> <span style=\\\"font-family: Söhne, ui-sans-serif, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, Ubuntu, Cantarell, \\\"Noto Sans\\\", sans-serif, \\\"Helvetica Neue\\\", Arial, \\\"Apple Color Emoji\\\", \\\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\\\", \\\"Noto Color Emoji\\\"; white-space-collapse: preserve;\\\">Becoming a volleyball referee involves several steps, but it's an achievable goal for anyone passionate about the sport and willing to put in the effort. Firstly, familiarize yourself with the rules and regulations of volleyball thoroughly. Understanding the intricacies of the game is crucial for making accurate calls during matches. Consider enrolling in a referee training program or workshop offered by local sports organizations or volleyball associations. These programs often provide comprehensive training on officiating techniques, positioning, and decision-making skills. Additionally, gaining practical experience by officiating matches at lower levels, such as local club or school games, can be invaluable for honing your skills and confidence on the court. Networking with experienced referees and seeking mentorship opportunities can also provide valuable guidance and support as you progress in your officiating journey. Finally, continue to refine your knowledge and skills through ongoing education and participation in workshops, seminars, and certification programs to stay updated on rule changes and best practices in volleyball officiating. With dedication and perseverance, you can become a competent and respected volleyball referee.</span></font>\"\n                    }\n                ]\n            },\n            {\n                \"id\": 2041,\n                \"teacher_id\": 1092,\n                \"creator_id\": 1092,\n                \"category_id\": 618,\n                \"type\": \"webinar\",\n                \"private\": 0,\n                \"slug\": \"education\",\n                \"start_date\": 1715202000,\n                \"duration\": 26,\n                \"timezone\": \"Europe/Istanbul\",\n                \"thumbnail\": \"360X250\",\n                \"image_cover\": \"1920X530\",\n                \"video_demo\": \"https://www.youtube.com/watch?v=nre4Js7u7z0\",\n                \"video_demo_source\": \"upload\",\n                \"capacity\": 25,\n                \"price\": 10,\n                \"organization_price\": null,\n                \"support\": 0,\n                \"certificate\": 0,\n                \"downloadable\": 0,\n                \"partner_instructor\": 0,\n                \"subscribe\": 1,\n                \"forum\": 0,\n                \"enable_waitlist\": 0,\n                \"access_days\": null,\n                \"points\": null,\n                \"message_for_reviewer\": null,\n                \"status\": \"active\",\n                \"created_at\": 1714738053,\n                \"updated_at\": 1714739008,\n                \"deleted_at\": null,\n                \"title\": null,\n                \"description\": null,\n                \"seo_description\": null,\n                \"translations\": [\n                    {\n                        \"id\": 189,\n                        \"webinar_id\": 2041,\n                        \"locale\": \"en\",\n                        \"title\": \"education\",\n                        \"seo_description\": null,\n                        \"description\": \"<p>Bu kursta IT ve Tester'lik konusunda merak ettiğiniz seylere cevap bulabilirsiniz</p>\"\n                    }\n                ]\n            },\n            {\n                \"id\": 2050,\n                \"teacher_id\": 1114,\n                \"creator_id\": 1114,\n                \"category_id\": 618,\n                \"type\": \"course\",\n                \"private\": 0,\n                \"slug\": \"Art-of-Bug-Finding-Software-Testing-Training\",\n                \"start_date\": 1714795200,\n                \"duration\": 45,\n                \"timezone\": \"America/New_York\",\n                \"thumbnail\": \"testing.png\",\n                \"image_cover\": \"testing.jpg\",\n                \"video_demo\": \"https://www.youtube.com/watch?v=38NHe7PZ54I&t=89s\",\n                \"video_demo_source\": \"youtube\",\n                \"capacity\": 10,\n                \"price\": null,\n                \"organization_price\": null,\n                \"support\": 0,\n                \"certificate\": 1,\n                \"downloadable\": 0,\n                \"partner_instructor\": 0,\n                \"subscribe\": 0,\n                \"forum\": 0,\n                \"enable_waitlist\": 0,\n                \"access_days\": 0,\n                \"points\": null,\n                \"message_for_reviewer\": null,\n                \"status\": \"active\",\n                \"created_at\": 1714799381,\n                \"updated_at\": 1715033193,\n                \"deleted_at\": null,\n                \"title\": null,\n                \"description\": null,\n                \"seo_description\": null,\n                \"translations\": [\n                    {\n                        \"id\": 195,\n                        \"webinar_id\": 2050,\n                        \"locale\": \"en\",\n                        \"title\": \"Art of Bug Finding: Software Testing Training\",\n                        \"seo_description\": \"Step into the world of software testing! Learn fundamental testing skills with the 'Art of Bug Finding: Software Testing Training' course. Gain experience with real-world projects and specialize in the field of software testing.\",\n                        \"description\": \"<p><span style=\\\"color: rgb(13, 13, 13); font-family: Söhne, ui-sans-serif, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, Ubuntu, Cantarell, \\\"Noto Sans\\\", sans-serif, \\\"Helvetica Neue\\\", Arial, \\\"Apple Color Emoji\\\", \\\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\\\", \\\"Noto Color Emoji\\\"; white-space-collapse: preserve;\\\">     Software testing is a critical stage in the software development process, ensuring the release of error-free products into the market. The 'Art of Bug Finding: Software Testing Training' course provides participants with a solid foundation in software testing concepts, methodologies, and tools, making it ideal for anyone looking to understand software testing principles.</span></p><p><span style=\\\"color: rgb(13, 13, 13); font-family: Söhne, ui-sans-serif, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, Ubuntu, Cantarell, \\\"Noto Sans\\\", sans-serif, \\\"Helvetica Neue\\\", Arial, \\\"Apple Color Emoji\\\", \\\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\\\", \\\"Noto Color Emoji\\\"; white-space-collapse: preserve;\\\">     The course covers fundamental testing principles, test planning, test design, automation testing, and bug tracking. Participants will gain practical experience by working on real-world projects and practicing various test scenarios to enhance their skills.</span></p><p><span style=\\\"color: rgb(13, 13, 13); font-family: Söhne, ui-sans-serif, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, Ubuntu, Cantarell, \\\"Noto Sans\\\", sans-serif, \\\"Helvetica Neue\\\", Arial, \\\"Apple Color Emoji\\\", \\\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\\\", \\\"Noto Color Emoji\\\"; white-space-collapse: preserve;\\\">     The training is supported by expert instructors who provide interactive lessons, practical examples, and group exercises. Students are guided at every step, fostering their ability to identify and resolve their own mistakes. Additionally, the course content includes the latest industry trends and best practices.</span></p><p><span style=\\\"color: rgb(13, 13, 13); font-family: Söhne, ui-sans-serif, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, Ubuntu, Cantarell, \\\"Noto Sans\\\", sans-serif, \\\"Helvetica Neue\\\", Arial, \\\"Apple Color Emoji\\\", \\\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\\\", \\\"Noto Color Emoji\\\"; white-space-collapse: preserve;\\\">     Upon completion of the course, participants will feel more confident in managing software testing processes, detecting and reporting bugs. They will have also honed a crucial skill for gaining a competitive edge in the business world.</span></p><p><span style=\\\"color: rgb(13, 13, 13); font-family: Söhne, ui-sans-serif, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, Ubuntu, Cantarell, \\\"Noto Sans\\\", sans-serif, \\\"Helvetica Neue\\\", Arial, \\\"Apple Color Emoji\\\", \\\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\\\", \\\"Noto Color Emoji\\\"; white-space-collapse: preserve;\\\">     In conclusion, the 'Art of Bug Finding: Software Testing Training' course offers an excellent opportunity for those aspiring to build a career in software testing or professionals looking to enhance their existing skills. Through this course, participants can establish a strong foundation and step confidently into a successful future in the world of software testing.</span><span style=\\\"color: rgb(13, 13, 13); font-family: Söhne, ui-sans-serif, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, Ubuntu, Cantarell, \\\"Noto Sans\\\", sans-serif, \\\"Helvetica Neue\\\", Arial, \\\"Apple Color Emoji\\\", \\\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\\\", \\\"Noto Color Emoji\\\"; white-space-collapse: preserve;\\\"><br></span><span style=\\\"color: rgb(13, 13, 13); font-family: Söhne, ui-sans-serif, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, Ubuntu, Cantarell, \\\"Noto Sans\\\", sans-serif, \\\"Helvetica Neue\\\", Arial, \\\"Apple Color Emoji\\\", \\\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\\\", \\\"Noto Color Emoji\\\"; white-space-collapse: preserve;\\\"><br></span><span style=\\\"color: rgb(13, 13, 13); font-family: Söhne, ui-sans-serif, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, Ubuntu, Cantarell, \\\"Noto Sans\\\", sans-serif, \\\"Helvetica Neue\\\", Arial, \\\"Apple Color Emoji\\\", \\\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\\\", \\\"Noto Color Emoji\\\"; white-space-collapse: preserve;\\\"><br></span><span style=\\\"color: rgb(13, 13, 13); font-family: Söhne, ui-sans-serif, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, Ubuntu, Cantarell, \\\"Noto Sans\\\", sans-serif, \\\"Helvetica Neue\\\", Arial, \\\"Apple Color Emoji\\\", \\\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\\\", \\\"Noto Color Emoji\\\"; white-space-collapse: preserve;\\\"><br></span></p>\"\n                    }\n                ]\n            },\n            {\n                \"id\": 2053,\n                \"teacher_id\": 1107,\n                \"creator_id\": 1107,\n                \"category_id\": null,\n                \"type\": \"webinar\",\n                \"private\": 0,\n                \"slug\": \"Tarihteki-ilk-kod-nasil-yazildi\",\n                \"start_date\": null,\n                \"duration\": null,\n                \"timezone\": null,\n                \"thumbnail\": \"/store/1107/f1e65fe2e9ce68076eba398593541504c2dd115d.jpeg\",\n                \"image_cover\": \"/store/1107/f1e65fe2e9ce68076eba398593541504c2dd115d.jpeg\",\n                \"video_demo\": null,\n                \"video_demo_source\": null,\n                \"capacity\": null,\n                \"price\": null,\n                \"organization_price\": null,\n                \"support\": 0,\n                \"certificate\": 0,\n                \"downloadable\": 0,\n                \"partner_instructor\": 0,\n                \"subscribe\": 0,\n                \"forum\": 0,\n                \"enable_waitlist\": 0,\n                \"access_days\": null,\n                \"points\": null,\n                \"message_for_reviewer\": null,\n                \"status\": \"active\",\n                \"created_at\": 1714897659,\n                \"updated_at\": 1715845302,\n                \"deleted_at\": null,\n                \"title\": null,\n                \"description\": null,\n                \"seo_description\": null,\n                \"translations\": [\n                    {\n                        \"id\": 198,\n                        \"webinar_id\": 2053,\n                        \"locale\": \"en\",\n                        \"title\": \"Tarihteki ilk kod nasil yazildi\",\n                        \"seo_description\": null,\