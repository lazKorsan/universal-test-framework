,\n                \"category_id\": 622,\n                \"type\": \"webinar\",\n                \"private\": 0,\n                \"slug\": \"Health-And-Fitness-Masterclass\",\n                \"start_date\": 1717419600,\n                \"duration\": 180,\n                \"timezone\": \"America/New_York\",\n                \"thumbnail\": \"/store/1/hhh.jpg\",\n                \"image_cover\": \"/store/1/hh.jpg\",\n                \"video_demo\": \"https://www.youtube.com/watch?v=mOBIOCeZ6IU\",\n                \"video_demo_source\": \"youtube\",\n                \"capacity\": 85,\n                \"price\": 65,\n                \"organization_price\": null,\n                \"support\": 1,\n                \"certificate\": 1,\n                \"downloadable\": 0,\n                \"partner_instructor\": 0,\n                \"subscribe\": 1,\n                \"forum\": 0,\n                \"enable_waitlist\": 0,\n                \"access_days\": null,\n                \"points\": null,\n                \"message_for_reviewer\": \"Thank you for your good services.\",\n                \"status\": \"active\",\n                \"created_at\": 1625122618,\n                \"updated_at\": 1713341155,\n                \"deleted_at\": null,\n                \"title\": null,\n                \"description\": null,\n                \"seo_description\": null,\n                \"translations\": [\n                    {\n                        \"id\": 8,\n                        \"webinar_id\": 2002,\n                        \"locale\": \"en\",\n                        \"title\": \"Health And Fitness Masterclass: Beginner To Advanced\",\n                        \"seo_description\": \"Health And Fitness Masterclass: Beginner To Advanced\",\n                        \"description\": \"<p style=\\\"border: 0px solid rgb(227, 227, 227); --tw-border-spacing-x: 0; --tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgba(69,89,164,.5); --tw-ring-offset-shadow: 0 0 transparent; --tw-ring-shadow: 0 0 transparent; --tw-shadow: 0 0 transparent; --tw-shadow-colored: 0 0 transparent; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ; margin: 1.25em 0px; font-family: Söhne, ui-sans-serif, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, Ubuntu, Cantarell, \\\"Noto Sans\\\", sans-serif, \\\"Helvetica Neue\\\", Arial, \\\"Apple Color Emoji\\\", \\\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\\\", \\\"Noto Color Emoji\\\"; font-size: 16px; white-space-collapse: preserve;\\\"><font color=\\\"#000000\\\">Welcome to the Health and Fitness Masterclass: Beginner to Advanced, where your journey to optimal health and vitality begins. Whether you're just starting out on your fitness journey or seeking to take your existing regimen to new heights, this comprehensive course is designed to empower you every step of the way.</font></p><p style=\\\"border: 0px solid rgb(227, 227, 227); --tw-border-spacing-x: 0; --tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgba(69,89,164,.5); --tw-ring-offset-shadow: 0 0 transparent; --tw-ring-shadow: 0 0 transparent; --tw-shadow: 0 0 transparent; --tw-shadow-colored: 0 0 transparent; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ; margin: 1.25em 0px; font-family: Söhne, ui-sans-serif, system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, Ubuntu, Cantarell, \\\"Noto Sans\\\", sans-serif, \\\"Helvetica Neue\\\", Arial, \\\"Apple Color Emoji\\\", \\\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\\\", \\\"Noto Color Emoji\\\"; font-size: 16px; white-space-collapse: preserve;\\\"><font color=\\\"#000000\\\">Led by seasoned fitness experts, this masterclass offers a holistic approach to health and wellness, blending science-backed principles with practical strategies to help you achieve your fitness goals effectively and sustainably. From understanding the fundamentals of nutrition to mastering advanced training techniques, each module is carefully crafted to provide you with the knowledge, tools, and motivation needed to succeed.</font></p><p style=\\\"border: 0px solid rgb(227, 227, 227); --tw-border-spacing-x: 0; --tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale